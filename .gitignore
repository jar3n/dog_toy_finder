# ROS 2 / colcon
**/ros2_ws/build/
**/ros2_ws/install/
**/ros2_ws/log/

# Pico / micro-ROS build output
firmware/pico_microros/build/*
firmware/pico_microros/lib/*
firmware/esp_cam/.pio/*
*.uf2
*.elf
*.bin
*.hex

# microros builder artefacts ignore
docker/microros_builder/microros/.build/*
docker/microros_builder/microros/artifacts/*

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Secrets / local config (API keys, WiFi credentials)
.env
*.env
config/env/*
!config/env/.gitkeep
!config/env/README.md
**/wifi_config.h
**/ros_config.h
**/imu_config.h
**/encoder_config.h
**/motor_config.h
**/cmd_vel_config.h
**/secrets*

# Data
data/logs/*
!data/logs/.gitkeep
rosa_agent/memory/*.db
**/rosa_agent/memory/*.db
*.bag
*.mcap

# Editors / OS
.vscode/
.idea/
.DS_Store
