# ROS 2 / colcon
**/ros2_ws/build/
**/ros2_ws/install/
**/ros2_ws/log/

# Vision snapshots written at runtime
**/dog_toy_finder_vision/results/

# Pico / micro-ROS build output
firmware/pico_microros/build/*
firmware/pico_microros/lib/*
firmware/esp_cam/.pio/*
*.uf2
*.elf
*.bin
*.hex

# microros builder artefacts ignore
docker/microros_builder/microros/.build/*
docker/microros_builder/microros/artifacts/*

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Secrets / local config (API keys, WiFi credentials)
.env
*.env
**/wifi_config.h
**/secrets*
rosa_agent/memory/*.db
**/rosa_agent/memory/*.db
*.bag
*.mcap

# Editors / OS
.vscode/
.idea/
.DS_Store

# Generated evaluation data (keep the vision/ and planning/ folders)
data/vision/*
data/planning/*
!data/vision/.gitkeep
!data/planning/.gitkeep

# Accidental colcon output if built from software/ instead of software/ros2_ws/
software/build/
software/install/
software/log/

# Host-side detector/depth weights and upstream repos (downloaded locally)
software/host_vision/models/*.pt
software/host_vision/models/*.pth
software/host_vision/models/*.ts
software/host_vision/models/hf/
software/host_vision/models/repos/
software/host_vision/models/fast_foundation_stereo/
software/host_vision/models/rt_igevpp/
weights/
