<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dog_toy_finder_bringup</name>
  <version>0.1.0</version>
  <description>
    Launch files and shared configuration for the Dog Toy Finder computer-side
    ROS 2 stack: wheel odometry, IMU mounting, and the robot_localization EKF.
  </description>
  <maintainer email="dogtoyfinder@example.com">Dog Toy Finder Team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>dog_toy_finder_odometry</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
