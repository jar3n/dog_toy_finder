# Copy to .env and load it before starting the agent, for example:
#   set -a; source .env; set +a
# The agent reads only these environment variables; .env is git-ignored.

# Ollama model and endpoint. With the ros2 container using host networking,
# Ollama on the same computer is reachable at localhost.
OLLAMA_MODEL=llama3.2
OLLAMA_URL=http://localhost:11434

# 1 asks the human to approve every move; 0 disables the prompt (use with care).
ROSA_REQUIRE_APPROVAL=1
