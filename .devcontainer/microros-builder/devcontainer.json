{
  "name": "Pico 2 W micro-ROS Builder",
  "build": {
    "dockerfile": "../../docker/microros_builder/Dockerfile",
    "context": "../../docker/microros_builder"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace/firmware/pico_microros/microros/builder",
  "remoteUser": "root",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cmake-tools",
        "ms-vscode.cpptools",
        "ms-iot.vscode-ros",
        "timonwong.shellcheck"
      ]
    }
  }
}
